# Auth0 Regular Web Application; never commit actual secrets.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=

# Spark/Flexmls server-only configuration. Never prefix the access token with
# NEXT_PUBLIC_ or expose it to browser code.
SPARK_API_FEED_ID=b5wrbwdkerfqnqd0a5ngc2bz0
SPARK_ACCESS_TOKEN=replace-with-the-non-expiring-access-token-from-spark

# Browser-safe only when restricted to this website and the Maps JavaScript API.
# The deployed project currently uses Google_Maps_API. NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
# remains supported as an alternate name.
Google_Maps_API=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
