SITE_PASSWORD=replace-with-a-long-random-password
AUTH_SECRET=replace-with-a-separate-long-random-secret

# Leave disabled until Redis and verified email delivery are configured.
EMAIL_CODE_ENABLED=false
PASSWORD_LOGIN_DISABLED=false
# AUTH_SECRET must be at least 32 cryptographically random characters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
# Use an address on a domain verified in Resend (SPF/DKIM).
AUTH_EMAIL_FROM=

